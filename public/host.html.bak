<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ping, host</title>
    <link rel="icon" type="image/svg+xml" href="/img/ping-logo.svg" />
    <link rel="icon" type="image/png" href="/img/ping-logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800;900&family=Manrope:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/host.css" />
  </head>
  <body>
    <header class="barra">
      <span id="numero"></span>
      <div id="cabecalho-lobby" class="cabecalho-lobby" hidden>
        <img id="marca-topo" src="/img/ping-logo.png" alt="Ping" />
        <div id="qr-bloco">
          <img id="qr" src="/qr.svg" alt="QR code para entrar na partida" />
          <div>
            <p id="url-play"></p>
            <p id="pin-sala"></p>
          </div>
        </div>
      </div>
      <span class="direita">
        <span id="contagem">0 na sala</span>
        <span id="conexao"></span>
        <button type="button" id="sair" class="sair">Sair</button>
      </span>
    </header>

    <main id="palco">
      <section id="abertura">
        <div id="sala">
          <h2 id="titulo-lobby">👥 Na sala: 0</h2>
          <button type="button" id="sortear" class="tema" hidden>Sortear times</button>
          <ul id="lobby" class="lobby"></ul>
        </div>
      </section>

      <section id="rodada" hidden>
        <p id="dobro" hidden>Vale o dobro</p>
        <h1 id="enunciado"></h1>
        <ol id="alternativas" class="alternativas"></ol>
        <p id="rapido"></p>
      </section>

      <section id="secao-placar" hidden>
        <ol id="placar-equipes" class="equipes" hidden></ol>
        <h2>Top 3</h2>
        <ol id="placar" class="placar"></ol>
        <p id="pergunta-dificil" hidden></p>
        <a id="relatorio" class="relatorio" href="/relatorio.csv" hidden>Baixar relatório da partida</a>
      </section>
    </main>

    <footer class="barra rodape">
      <span id="contador">0 de 0 responderam</span>
      <button id="avancar" class="botao">Iniciar</button>
    </footer>

    <div id="reacoes" aria-hidden="true"></div>

    <script src="/js/host.js"></script>
  </body>
</html>